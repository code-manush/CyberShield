# CyberShield Environment Configuration
PROJECT_NAME="CyberShield NIDPS"
ENVIRONMENT="development"
DEBUG=true

# Server Configuration
HOST="127.0.0.1"
PORT=8000
SECRET_KEY="cybershield-secure-dev-key-change-in-production"

# Database Configuration (SQLite by default, PostgreSQL compatible)
DATABASE_URL="sqlite:///./cybershield.db"

# Prevention Configuration
# Mode options: OBSERVE, ALERT, ENFORCE
PREVENTION_MODE="OBSERVE"
# Adapter options: SIMULATION, LINUX_IPTABLES
FIREWALL_ADAPTER="SIMULATION"
DEFAULT_BLOCK_DURATION_SECONDS=300

# Trusted IP Allowlist (comma separated)
TRUSTED_IPS="127.0.0.1,::1,10.0.0.1,192.168.1.1"

# Network Monitoring Defaults
DEFAULT_INTERFACE=""
PORT_SCAN_THRESHOLD=15
PORT_SCAN_WINDOW_SECONDS=10.0
PORT_SCAN_COOLDOWN_SECONDS=30.0

SYN_FLOOD_THRESHOLD=100
SYN_FLOOD_WINDOW_SECONDS=5.0
SYN_FLOOD_COOLDOWN_SECONDS=30.0

BRUTE_FORCE_THRESHOLD=10
BRUTE_FORCE_WINDOW_SECONDS=60.0
BRUTE_FORCE_LOCKOUT_SECONDS=60.0
